{
  "manifest_version": 3,
  "name": "Claude Usage Widget",
  "version": "1.3",
  "description": "Polls claude.ai usage and feeds local widget",
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:3999/*"
  ]
}
